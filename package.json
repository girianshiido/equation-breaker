{
  "name": "equation-breaker",
  "version": "1.5.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "qa": "node scripts/browser-qa.mjs",
    "qa:updates": "node scripts/update-qa.mjs",
    "qa:gestures": "node scripts/gesture-qa.mjs",
    "qa:polish": "node scripts/polish-qa.mjs",
    "qa:audio": "node scripts/audio-qa.mjs",
    "qa:mobile": "node scripts/mobile-qa.mjs",
    "qa:systems": "node scripts/systems-qa.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "playwright": "^1.56.0",
    "@types/node": "^22.18.6"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
